{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Bug Fix Workflow",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "main", "label": "Bug Fix Process" },
    { "id": "terminal", "label": "Outcomes" }
  ],
  "states": [
    { "id": "report", "type": "start", "label": "Bug Reported", "sublabel": "symptom + location", "lane": "main", "col": 0, "step": "01" },
    { "id": "assess", "type": "decision", "label": "Assess", "sublabel": "root cause + scope", "lane": "main", "col": 1, "step": "02", "tag": "hard gate" },
    { "id": "fix", "type": "active", "label": "Fix", "sublabel": "in-scope files only", "lane": "main", "col": 2, "step": "03" },
    { "id": "verify", "type": "decision", "label": "Verify", "sublabel": "bug gone, no regressions", "lane": "main", "col": 3, "step": "04", "tag": "hard gate" },
    { "id": "reopened", "type": "failure", "label": "Reopened", "sublabel": "fix incomplete", "lane": "terminal", "col": 1 },
    { "id": "resolved", "type": "success", "label": "Resolved", "sublabel": "confirmed fixed", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "from": "report", "to": "assess" },
    { "from": "assess", "to": "fix", "label": "cause confirmed", "variant": "emphasis", "route": "straight", "labelDy": 58 },
    { "from": "fix", "to": "verify" },
    { "from": "verify", "to": "resolved", "label": "confirmed fixed", "variant": "emphasis" },
    { "from": "verify", "to": "reopened", "label": "still failing", "variant": "security", "route": "straight", "fromSide": "bottom", "toSide": "top", "labelDy": 24 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Hard Gates",
      "items": [
        "Assess: AI must name root cause and in-scope files before any code changes",
        "Verify: original symptom must be gone with no new failures introduced"
      ]
    },
    {
      "dot": "rose",
      "title": "Scope Discipline",
      "items": [
        "Fix touches only files listed in the assess output",
        "If Verify fails, the bug is Reopened — return to Assess and re-scope"
      ]
    }
  ]
}
